# Copy to /opt/weddingbank/deploy/gitlab-registry.env on the server. Do not commit the copy.
# Project deploy token with only read_registry and read_package_registry.
# Do not name that token gitlab-deploy-token.
GITLAB_REGISTRY=registry.gitlab.com
GITLAB_DEPLOY_USER=replace-on-server
GITLAB_DEPLOY_TOKEN=replace-on-server
