# Nginx Proxy Manager stuurt wedding-bank.evsb.io naar dit adres.
PROXY_BIND_ADDRESS=10.120.10.100
PROXY_PORT=8080

POSTGRES_USER=weddingbank
POSTGRES_PASSWORD=replace-on-server
